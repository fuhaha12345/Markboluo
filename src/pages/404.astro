---
import ArrowLink from '../components/ArrowLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 / Markboluo" description="这个页面不存在，返回 Markboluo 首页继续浏览。">
  <section class="empty-page" aria-labelledby="not-found-title">
    <h1 id="not-found-title">404，<br />这里没有页面。</h1>
    <p>地址可能已经改变，或者这个位置还没有内容。</p>
    <ArrowLink href={import.meta.env.BASE_URL}>返回首页</ArrowLink>
  </section>
</BaseLayout>
